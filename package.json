{
  "name": "labelcraft",
  "productName": "锋芒标签打印",
  "version": "0.1.0",
  "private": true,
  "description": "锋芒标签打印 — 桌面标签设计打印工具",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "check": "node scripts/check-electron.mjs && node scripts/verify-print.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "dist": "npm run pack"
  },
  "dependencies": {
    "jsbarcode": "^3.12.1",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "playwright-core": "^1.65.0",
    "rcedit": "^5.0.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.fengmang.labelprint",
    "productName": "锋芒标签打印",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/rawprint.ps1",
        "to": "rawprint.ps1"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "FengmangLabel-${version}-${arch}.${ext}",
      "icon": "electron/icon.ico"
    }
  }
}
